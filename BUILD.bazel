load("@rules_cuda//cuda:defs.bzl", "cuda_binary")

cuda_binary(
    name = "exp2_bench",
    srcs = ["src/bench.cu"],
    # Included by bench.cu, rather than compiled as a separate translation unit.
    hdrs = ["src/exp2.cuh", "src/alu.cuh"],
    copts = [
        "-O3",
        "-std=c++17",
        "-lineinfo",
    ],
    host_copts = ["-std=c++17"],
    ptxasopts = ["-v", "-warn-spills"],
    visibility = ["//visibility:public"],
)
